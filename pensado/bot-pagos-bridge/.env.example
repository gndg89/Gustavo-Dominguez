# Copia este archivo a ".env" y llena los valores reales. Nunca subas el .env real a git.

# --- WhatsApp Cloud API (Meta) ---
# Se consiguen al crear la app de WhatsApp Business en developers.facebook.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token que tu eliges para que Meta verifique el webhook (cualquier palabra secreta)
WHATSAPP_VERIFY_TOKEN=pensado-verify-2026

# --- Telegram (Mafe aprueba pagos aqui) ---
# Se consigue hablando con @BotFather en Telegram (/newbot)
TELEGRAM_BOT_TOKEN=
# El chat_id de Mafe en Telegram (se obtiene escribiendole al bot y llamando a
# https://api.telegram.org/bot<token>/getUpdates una vez)
TELEGRAM_CHAT_ID=

# --- Servidor ---
PORT=3000
